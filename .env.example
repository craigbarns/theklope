# --- Client (exposé au navigateur, préfixe VITE_) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Serveur uniquement (fonctions api/, NE JAMAIS exposer au navigateur) ---
# Clé service_role Supabase : permet au serveur de créer/mettre à jour les commandes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# (optionnel) si l'URL Supabase n'est pas déjà fournie côté serveur :
SUPABASE_URL=https://your-project.supabase.co

# Mollie : clé API (test_xxx en test, live_xxx en production)
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secrets HMAC serveur (valeurs aléatoires distinctes, 32 octets ou plus).
# Le service_role sert de repli, mais des secrets dédiés facilitent leur rotation.
CHECKOUT_IDEMPOTENCY_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# Resend : optionnel, envoi des confirmations commande et alertes internes
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel Cron : secret aléatoire d'au moins 16 caractères. Vercel l'envoie
# automatiquement en `Authorization: Bearer ...` à /api/cleanup-checkouts.
CRON_SECRET=replace-with-at-least-32-random-characters

# URL publique du site (pour redirectUrl / webhookUrl Mollie).
# En local avec un tunnel (ngrok) : https://xxxx.ngrok.io
PUBLIC_BASE_URL=https://www.theklope.com

# Mondial Relay API 1 (SOAP) : recherche Point Relais / Locker et suivi.
# Paramètres Connect > Mes paramètres de production. Serveur uniquement.
MONDIAL_RELAY_API1_ENSEIGNE=your-brand-code
MONDIAL_RELAY_API1_PRIVATE_KEY=your-private-key

# Mondial Relay API 2 (REST/XML) : création d'expédition et étiquette PDF.
# Générer un utilisateur technique depuis Connect > Configuration des API.
MONDIAL_RELAY_API2_LOGIN=your-login@business-api.mondialrelay.com
MONDIAL_RELAY_API2_PASSWORD=your-api-password
MONDIAL_RELAY_API2_CUSTOMER_ID=your-customer-id
# Optionnel : la production est utilisée par défaut.
MONDIAL_RELAY_API2_URL=https://connect-api.mondialrelay.com/api/Shipment

# Coordonnées expéditeur imprimées sur l'étiquette (valeurs THEKLOPE par défaut).
MONDIAL_RELAY_SENDER_NAME=THEKLOPE
MONDIAL_RELAY_SENDER_STREET=188 rue de Rome
MONDIAL_RELAY_SENDER_POSTCODE=13006
MONDIAL_RELAY_SENDER_CITY=Marseille
MONDIAL_RELAY_SENDER_COUNTRY_CODE=FR
MONDIAL_RELAY_SENDER_PHONE=+33491555555
MONDIAL_RELAY_SENDER_EMAIL=contact@theklope.com
